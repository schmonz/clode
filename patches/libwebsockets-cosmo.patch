diff --git a/lib/misc/sha-1.c b/lib/misc/sha-1.c
index 22989e4e..f9822d30 100644
--- a/lib/misc/sha-1.c
+++ b/lib/misc/sha-1.c
@@ -54,6 +54,23 @@ struct sha1_ctxt {
 	unsigned char			count;
 };

+/* Cosmopolitan defines BYTE_ORDER/LITTLE_ENDIAN/BIG_ENDIAN as aliases to
+ * __BYTE_ORDER/__LITTLE_ENDIAN/__BIG_ENDIAN, which it never actually defines.
+ * In #if arithmetic those undefined names are 0, so both "== LITTLE_ENDIAN"
+ * and "== BIG_ENDIAN" evaluate 0==0 (true) and this file compiles an
+ * inconsistent mix of little- and big-endian byte paths -> wrong SHA-1 (and a
+ * broken WebSocket Sec-WebSocket-Accept check). Re-derive the macros from the
+ * compiler's own __BYTE_ORDER__ builtin, which is always correct. */
+#if defined(__COSMOPOLITAN__) && defined(__BYTE_ORDER__) && \
+    defined(__ORDER_LITTLE_ENDIAN__) && defined(__ORDER_BIG_ENDIAN__)
+# undef BYTE_ORDER
+# undef LITTLE_ENDIAN
+# undef BIG_ENDIAN
+# define LITTLE_ENDIAN __ORDER_LITTLE_ENDIAN__
+# define BIG_ENDIAN    __ORDER_BIG_ENDIAN__
+# define BYTE_ORDER    __BYTE_ORDER__
+#endif
+
 /* sanity check */
 #if !defined(BYTE_ORDER) || !defined(LITTLE_ENDIAN) || !defined(BIG_ENDIAN)
 # define unsupported 1
