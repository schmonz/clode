+#endif
+#ifdef EAGAIN
+  if (e == EAGAIN) return UV_EAGAIN;
+#endif
+#ifdef EALREADY
+  if (e == EALREADY) return UV_EALREADY;
+#endif
+#ifdef EBADF
+  if (e == EBADF) return UV_EBADF;
+#endif
+#ifdef EBUSY
+  if (e == EBUSY) return UV_EBUSY;
+#endif
+#ifdef ECANCELED
+  if (e == ECANCELED) return UV_ECANCELED;
+#endif
+#ifdef ECHARSET
+  if (e == ECHARSET) return UV_ECHARSET;
+#endif
+#ifdef ECONNABORTED
+  if (e == ECONNABORTED) return UV_ECONNABORTED;
+#endif
+#ifdef ECONNREFUSED
+  if (e == ECONNREFUSED) return UV_ECONNREFUSED;
+#endif
+#ifdef ECONNRESET
+  if (e == ECONNRESET) return UV_ECONNRESET;
+#endif
+#ifdef EDESTADDRREQ
+  if (e == EDESTADDRREQ) return UV_EDESTADDRREQ;
+#endif
+#ifdef EEXIST
+  if (e == EEXIST) return UV_EEXIST;
+#endif
+#ifdef EFAULT
+  if (e == EFAULT) return UV_EFAULT;
+#endif
+#ifdef EFBIG
+  if (e == EFBIG) return UV_EFBIG;
+#endif
+#ifdef EFTYPE
+  if (e == EFTYPE) return UV_EFTYPE;
+#endif
+#ifdef EHOSTDOWN
+  if (e == EHOSTDOWN) return UV_EHOSTDOWN;
+#endif
+#ifdef EHOSTUNREACH
+  if (e == EHOSTUNREACH) return UV_EHOSTUNREACH;
+#endif
+#ifdef EILSEQ
+  if (e == EILSEQ) return UV_EILSEQ;
+#endif
+#ifdef EINTR
+  if (e == EINTR) return UV_EINTR;
+#endif
+#ifdef EINVAL
+  if (e == EINVAL) return UV_EINVAL;
+#endif
+#ifdef EIO
+  if (e == EIO) return UV_EIO;
+#endif
+#ifdef EISCONN
+  if (e == EISCONN) return UV_EISCONN;
+#endif
+#ifdef EISDIR
+  if (e == EISDIR) return UV_EISDIR;
+#endif
+#ifdef ELOOP
+  if (e == ELOOP) return UV_ELOOP;
+#endif
+#ifdef EMFILE
+  if (e == EMFILE) return UV_EMFILE;
+#endif
+#ifdef EMLINK
+  if (e == EMLINK) return UV_EMLINK;
+#endif
+#ifdef EMSGSIZE
+  if (e == EMSGSIZE) return UV_EMSGSIZE;
+#endif
+#ifdef ENAMETOOLONG
+  if (e == ENAMETOOLONG) return UV_ENAMETOOLONG;
+#endif
+#ifdef ENETDOWN
+  if (e == ENETDOWN) return UV_ENETDOWN;
+#endif
+#ifdef ENETUNREACH
+  if (e == ENETUNREACH) return UV_ENETUNREACH;
+#endif
