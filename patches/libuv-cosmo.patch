+#endif
+#ifdef ENODEV
+  if (e == ENODEV) return UV_ENODEV;
+#endif
+#ifdef ENOENT
+  if (e == ENOENT) return UV_ENOENT;
+#endif
+#ifdef ENOEXEC
+  if (e == ENOEXEC) return UV_ENOEXEC;
+#endif
+#ifdef ENOMEM
+  if (e == ENOMEM) return UV_ENOMEM;
+#endif
+#ifdef ENONET
+  if (e == ENONET) return UV_ENONET;
+#endif
+#ifdef ENOPROTOOPT
+  if (e == ENOPROTOOPT) return UV_ENOPROTOOPT;
+#endif
+#ifdef ENOSPC
+  if (e == ENOSPC) return UV_ENOSPC;
+#endif
+#ifdef ENOSYS
+  if (e == ENOSYS) return UV_ENOSYS;
+#endif
+#ifdef ENOTCONN
+  if (e == ENOTCONN) return UV_ENOTCONN;
+#endif
+#ifdef ENOTDIR
+  if (e == ENOTDIR) return UV_ENOTDIR;
+#endif
