--- a/src/uv-common.h
+++ b/src/uv-common.h
@@ -42,7 +42,17 @@
 # include <stdatomic.h>
 #endif
 
-#if EDOM > 0
+/* Cosmopolitan: errno macros are runtime symbols, not preprocessor constants.
+ * `#if EDOM > 0` is false (so libuv would pick the non-negating UV__ERR), AND
+ * the enum uses FIXED -40xx codes (uv/errno.h) while syscalls set the runtime
+ * errno. Translate runtime errno -> the fixed UV_E* code (src/unix/cosmo.c) so
+ * every error is a proper, named UV code (uv_err_name/strerror + node-shim
+ * e.code all match). #undef first to override uv/errno.h's plain macro. */
+#if defined(__COSMOPOLITAN__)
+int uv__translate_sys_errno(int sys_errno);
+# undef UV__ERR
+# define UV__ERR(x) uv__translate_sys_errno(x)
+#elif EDOM > 0
