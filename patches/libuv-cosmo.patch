+#ifndef UV_COSMO_H
+#define UV_COSMO_H
+
+/* Cosmopolitan (Actually Portable Executable) targets no single OS at compile
+ * time — one binary runs on Linux/macOS/Windows/BSD, so libuv uses the generic
+ * poll(2) event loop (posix.h supplies the loop's pollfd bookkeeping fields). */
+#include "uv/posix.h"
+
+/* Cosmopolitan's libc does not declare these interface helpers (its net/if.h
+ * omits them and no symbol is exported). libuv's cosmo platform file
+ * (src/unix/cosmo.c) provides them; declare the prototypes here so every
+ * translation unit that includes <uv.h> sees them. */
+unsigned int if_nametoindex(const char* ifname);
+char* if_indextoname(unsigned int ifindex, char* ifname);
+
+#endif /* UV_COSMO_H */
