+  if (e == ENOTEMPTY) return UV_ENOTEMPTY;
+#endif
+#ifdef ENOTSOCK
+  if (e == ENOTSOCK) return UV_ENOTSOCK;
+#endif
+#ifdef ENOTSUP
+  if (e == ENOTSUP) return UV_ENOTSUP;
+#endif
+#ifdef ENOTTY
+  if (e == ENOTTY) return UV_ENOTTY;
+#endif
+#ifdef ENXIO
+  if (e == ENXIO) return UV_ENXIO;
+#endif
+#ifdef EOVERFLOW
+  if (e == EOVERFLOW) return UV_EOVERFLOW;
+#endif
+#ifdef EPERM
+  if (e == EPERM) return UV_EPERM;
+#endif
+#ifdef EPIPE
+  if (e == EPIPE) return UV_EPIPE;
+#endif
+#ifdef EPROTO
+  if (e == EPROTO) return UV_EPROTO;
+#endif
+#ifdef EPROTONOSUPPORT
+  if (e == EPROTONOSUPPORT) return UV_EPROTONOSUPPORT;
+#endif
+#ifdef EPROTOTYPE
+  if (e == EPROTOTYPE) return UV_EPROTOTYPE;
+#endif
+#ifdef ERANGE
+  if (e == ERANGE) return UV_ERANGE;
+#endif
+#ifdef EREMOTEIO
+  if (e == EREMOTEIO) return UV_EREMOTEIO;
+#endif
+#ifdef EROFS
+  if (e == EROFS) return UV_EROFS;
+#endif
+#ifdef ESHUTDOWN
+  if (e == ESHUTDOWN) return UV_ESHUTDOWN;
+#endif
+#ifdef ESOCKTNOSUPPORT
+  if (e == ESOCKTNOSUPPORT) return UV_ESOCKTNOSUPPORT;
+#endif
+#ifdef ESPIPE
+  if (e == ESPIPE) return UV_ESPIPE;
+#endif
+#ifdef ESRCH
+  if (e == ESRCH) return UV_ESRCH;
+#endif
+#ifdef ETIMEDOUT
+  if (e == ETIMEDOUT) return UV_ETIMEDOUT;
+#endif
+#ifdef ETXTBSY
+  if (e == ETXTBSY) return UV_ETXTBSY;
+#endif
+#ifdef EUNATCH
+  if (e == EUNATCH) return UV_EUNATCH;
