+/* Cosmopolitan (APE) platform file for libuv.
+ *
+ * Cosmopolitan targets no single OS at compile time, so libuv builds against
+ * the generic poll(2) event loop (posix-poll.c) plus this file for the few
+ * facilities Cosmopolitan's libc does not provide. Where Cosmopolitan lacks a
+ * portable primitive, we return an empty/absent result rather than a wrong one:
+ * none of these paths is exercised by a global-DNS client such as quaude
+ * (interface enumeration, and IPv6 scoped/link-local zone resolution). If a
+ * consumer ever needs them, replace the stubs with a per-runtime-OS
+ * implementation dispatched through Cosmopolitan's syscall layer. */
+
+#include "uv.h"
+#include "internal.h"
+
+#include <errno.h>
+#include <unistd.h>
+
+/* Cosmopolitan's libc exports no interface index<->name helpers. Absent an
+ * interface scope, if_nametoindex() reports "no scope" (0), which leaves
+ * global and DNS-resolved addresses fully functional; only named-zone
+ * link-local IPv6 (e.g. "fe80::1%eth0") loses its zone id. */
+unsigned int if_nametoindex(const char* ifname) {
+  (void) ifname;
+  return 0;
+}
+
+char* if_indextoname(unsigned int ifindex, char* ifname) {
+  (void) ifindex;
+  (void) ifname;
+  return NULL;
+}
+
+/* No portable interface enumeration on Cosmopolitan (no getifaddrs, no
+ * SIOCGIFCONF struct). Report an empty set; uv_free_interface_addresses()
+ * (common code) is a no-op on NULL. */
+int uv_interface_addresses(uv_interface_address_t** addresses, int* count) {
+  *addresses = NULL;
+  *count = 0;
+  return 0;
+}
+
+/* Misc platform-info functions the per-OS file (hurd.c/linux.c) normally
+ * supplies. Cosmopolitan has no single portable source for load average, uptime,
+ * or per-CPU info across its host OSes, so report empty/zero (os.loadavg() ->
+ * [0,0,0], os.uptime() -> 0, os.cpus() -> []). uv_exepath uses Cosmopolitan's
+ * cross-host /proc/self/exe emulation, so process.execPath works everywhere. */
+void uv_loadavg(double avg[3]) {
+  avg[0] = avg[1] = avg[2] = 0;
+}
+
+int uv_uptime(double* uptime) {
+  *uptime = 0;
+  return 0;
+}
+
+int uv_cpu_info(uv_cpu_info_t** cpu_infos, int* count) {
+  *cpu_infos = NULL;
+  *count = 0;
+  return 0;
+}
+
+int uv_exepath(char* buffer, size_t* size) {
+  if (buffer == NULL || size == NULL || *size == 0)
+    return UV_EINVAL;
+  ssize_t n = readlink("/proc/self/exe", buffer, *size - 1);
+  if (n < 0)
+    return UV__ERR(errno);
+  buffer[n] = '\0';
+  *size = (size_t) n;
+  return 0;
+}
