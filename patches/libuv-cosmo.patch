diff --git a/CMakeLists.txt b/CMakeLists.txt
index e67259b..88c4c87 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -324,6 +324,21 @@ if(CMAKE_SYSTEM_NAME STREQUAL "GNU")
        src/unix/hurd.c)
 endif()
 
+if(CMAKE_SYSTEM_NAME STREQUAL "Cosmopolitan")
+  # Actually Portable Executable: one binary, no compile-time OS, so use the
+  # generic poll(2) event loop. _DEFAULT_SOURCE (NOT the strict _POSIX_C_SOURCE/
+  # _XOPEN_SOURCE caps, which hide Cosmopolitan's default-source declarations).
+  # src/unix/cosmo.c supplies the few libc gaps; no bsd-ifaddrs.c (no
+  # <net/if_dl.h> on cosmo) and no hurd.c. dlopen lives in libc (no -ldl).
+  list(APPEND uv_defines _GNU_SOURCE _DEFAULT_SOURCE)
+  list(APPEND uv_sources
+       src/unix/no-fsevents.c
+       src/unix/no-proctitle.c
+       src/unix/posix-hrtime.c
+       src/unix/posix-poll.c
+       src/unix/cosmo.c)
+endif()
+
 if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
   list(APPEND uv_defines _GNU_SOURCE _POSIX_C_SOURCE=200112)
   list(APPEND uv_libraries dl rt)
