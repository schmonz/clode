# JOB-REALM-REF: a queued promise job holds a reference to the context it runs in.
#
# WHY. JS_EnqueueJob stored the queuing JSContext as a bare pointer (e->ctx = ctx), and
# JS_ExecutePendingJob ran the job in it later. Nothing kept that context alive in between.
# A context lives while something references it (each of its builtin functions, bytecode
# functions and autoinit properties holds a JS_DupContext), and a job's arguments need not
# be any of those: the child context's own Promise.prototype.then, applied to a host
# promise that has already settled, queues a reaction job IN the child whose arguments are
# all host values. When a vm context (txiki-vm-context.patch, src/mod_vm.c: the Workflow
# tool's script realm) is dropped, the cycle collector frees it, and the job then runs with
# freed memory as its context.
#
# MEASURED (2026-11-21). quaude died of SIGSEGV mid-turn in tools-local's "ReportFindings,
# Workflow and ListAgents" test on NetBSD/arm64: 2 of 25 runs of that one test, 0 of 40 on
# darwin-arm64. Both cores: free_gc_object reading a NULL shape (an object freed twice)
# under js_new_promise_capability <- js_promise_then_finally_func <- promise_reaction_job.
# An AddressSanitizer engine (darwin-arm64) running a vm workflow shape: heap-use-after-
# free READ of the JSContext in js_async_function_resume, the context freed by
# JS_FreeContext <- js_c_function_finalizer <- gc_free_cycles. Unpatched, the program in
# test/node-shim-vm-job-realm.test.cjs SIGSEGVs on every run; patched, it prints 42.
#
# THE CHANGE. JS_EnqueueJob takes a reference (JS_DupContext); JS_ExecutePendingJob drops
# it after the job and its arguments are freed; JS_FreeRuntime drops the references of
# jobs still queued at teardown. A quickjs-ng upstream candidate. *pctx still names the
# job's context, which may be freed by the
# time JS_ExecutePendingJob returns unless the caller holds its own reference (txiki's
# callers do not read it).
diff --git a/quickjs.c b/quickjs.c
--- a/quickjs.c
+++ b/quickjs.c
@@ -2155,7 +2155,7 @@
     e = js_malloc(ctx, sizeof(*e) + argc * sizeof(JSValue));
     if (!e)
         return -1;
-    e->ctx = ctx;
+    e->ctx = JS_DupContext(ctx); /* JOB-REALM-REF: the context outlives the queued job */
     e->job_func = job_func;
     e->argc = argc;
     for(i = 0; i < argc; i++) {
@@ -2206,6 +2206,7 @@
     JS_FreeValue(ctx, res);
     js_free(ctx, e);
     *pctx = ctx;
+    JS_FreeContext(ctx);
     return ret;
 }

@@ -2306,6 +2307,7 @@
         JSJobEntry *e = list_entry(el, JSJobEntry, link);
         for(i = 0; i < e->argc; i++)
             JS_FreeValueRT(rt, e->argv[i]);
+        JS_FreeContext(e->ctx);
         js_free_rt(rt, e);
     }
     init_list_head(&rt->job_list);
