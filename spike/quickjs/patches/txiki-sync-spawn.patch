+/* __tjs_execve(file, argv[], envp[]): replace this process image, node's
+ * process.execve (src/node_process_methods.cc Execve). argv[0] is the new
+ * image's argv0 (node's args), envp is "K=V"[]. Never returns on success.
+ *
+ * What the new image inherits, made to match what it inherits from node and
+ * from Bun (MEASURED 2026-11-22, darwin-arm64, node 26.10 and Bun 1.4.4: a perl
+ * probe exec'd from each reports fds 0-2 blocking, no fd above 2 open, an empty
+ * signal mask, and SIGPIPE still ignored):
+ *   - fds 0-2 lose close-on-exec (node does exactly this) AND O_NONBLOCK, which
+ *     libuv sets on a tty it drives. O_NONBLOCK lives on the open file
+ *     description, so a leaked one makes the next program's first read of the
+ *     terminal fail EAGAIN (the /quit wedge was this leak through a sync open).
+ *   - every other fd is made close-on-exec: node never leaks one because libuv
+ *     opens everything O_CLOEXEC; node-shim's sync fs does not promise that.
+ *   - the tty mode libuv set is restored (uv_tty_reset_mode, as node calls).
+ *   - the signal mask is emptied. Dispositions are left alone: a caught signal
+ *     reverts to default across exec by itself, and an ignored one (SIGPIPE)
+ *     stays ignored, which is what both node and Bun hand on.
+ * On failure everything restorable is restored and a node-shaped error is
+ * thrown: node 26's ErrnoException, "<CODE>, <strerror> '<file>'", with errno,
+ * code, path and syscall 'execve'. */
+static JSValue js_execve(JSContext *ctx, JSValueConst this_val, int argc, JSValueConst *argv) {
+    const char *file = JS_ToCString(ctx, argv[0]);
+    if (!file) return JS_EXCEPTION;
+    char **cargv = js_string_array(ctx, argv[1], 0, NULL);
+    char **cenv = js_string_array(ctx, argv[2], 0, NULL);
+    if (!cargv || !cenv) {
+        free_string_array(cargv); free_string_array(cenv); JS_FreeCString(ctx, file);
+        return JS_ThrowOutOfMemory(ctx);
+    }
+
+    int saved_fl[3], saved_fd[3];
+    for (int i = 0; i < 3; i++) {
+        saved_fl[i] = fcntl(i, F_GETFL);
+        saved_fd[i] = fcntl(i, F_GETFD);
+        if (saved_fl[i] != -1 && (saved_fl[i] & O_NONBLOCK)) fcntl(i, F_SETFL, saved_fl[i] & ~O_NONBLOCK);
+        if (saved_fd[i] != -1 && (saved_fd[i] & FD_CLOEXEC)) fcntl(i, F_SETFD, saved_fd[i] & ~FD_CLOEXEC);
+    }
+    long maxfd = 1024;
+    struct rlimit rl;
+    if (getrlimit(RLIMIT_NOFILE, &rl) == 0 && rl.rlim_cur != RLIM_INFINITY) maxfd = (long)rl.rlim_cur;
+    if (maxfd > 65536) maxfd = 65536;
+    for (int fd = 3; fd < maxfd; fd++) set_cloexec(fd);
+
+    uv_tty_reset_mode();
+    sigset_t none, oldmask;
+    sigemptyset(&none);
+    pthread_sigmask(SIG_SETMASK, &none, &oldmask);
+
+    execve(file, cargv, cenv);
+    int e = errno;
+
+    pthread_sigmask(SIG_SETMASK, &oldmask, NULL);
+    for (int i = 0; i < 3; i++) {
+        if (saved_fl[i] != -1) fcntl(i, F_SETFL, saved_fl[i]);
+        if (saved_fd[i] != -1) fcntl(i, F_SETFD, saved_fd[i]);
+    }
+
+    const char *code = uv_err_name(uv_translate_sys_error(e));
+    char msg[1400];
+    snprintf(msg, sizeof(msg), "%s, %s '%s'", code, strerror(e), file);
+    JSValue err = JS_NewError(ctx);
+    JS_DefinePropertyValueStr(ctx, err, "message", JS_NewString(ctx, msg), JS_PROP_WRITABLE | JS_PROP_CONFIGURABLE);  /* not enumerable, as an Error's message is */
+    JS_DefinePropertyValueStr(ctx, err, "errno", JS_NewInt32(ctx, e), JS_PROP_C_W_E);
+    JS_DefinePropertyValueStr(ctx, err, "code", JS_NewString(ctx, code), JS_PROP_C_W_E);
+    JS_DefinePropertyValueStr(ctx, err, "path", JS_NewString(ctx, file), JS_PROP_C_W_E);
+    JS_DefinePropertyValueStr(ctx, err, "syscall", JS_NewString(ctx, "execve"), JS_PROP_C_W_E);
+    free_string_array(cargv); free_string_array(cenv); JS_FreeCString(ctx, file);
+    return JS_Throw(ctx, err);
+}
