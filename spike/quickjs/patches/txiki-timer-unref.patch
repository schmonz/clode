+/* CLODE: setTimeout/setInterval return a plain int64 id (spec/node-shaped), not a
+ * handle object, so there is nowhere for a `.unref()` method to live. Node's
+ * timer ids ARE unref-able (via the hidden Timeout object); callers that need
+ * that here (AbortSignal.timeout's internal timer, see abort-controller.js) go
+ * through these two id-keyed functions instead. magic: 0 = unref, 1 = ref -
+ * mirrors the tjs_setTimeout(magic: 0 = timeout, 1 = interval) convention above
+ * and the Stream ref/unref pair in mod_streams.c. Unknown/already-fired ids are
+ * silently ignored (same tolerance as clearTimeout on a stale id). */
+static JSValue tjs_timer_setref(JSContext *ctx, JSValue this_val, int argc, JSValue *argv, int magic) {
+    TJSRuntime *qrt = JS_GetContextOpaque(ctx);
+    CHECK_NOT_NULL(qrt);
+    int64_t timer_id;
+    TJSTimer *th = NULL;
+
+    if (JS_ToInt64(ctx, &timer_id, argv[0])) {
+        return JS_EXCEPTION;
+    }
+
+    HASH_FIND_INT64(qrt->timers.timers, &timer_id, th);
+
+    if (th != NULL) {
+        if (magic) {
+            uv_ref((uv_handle_t *) &th->handle);
+        } else {
+            uv_unref((uv_handle_t *) &th->handle);
+        }
+    }
+
+    return JS_UNDEFINED;
+}
+
 static const JSCFunctionListEntry tjs_timer_funcs[] = { JS_CFUNC_MAGIC_DEF("setTimeout", 2, tjs_setTimeout, 0),
                                                         TJS_CFUNC_DEF("clearTimeout", 1, tjs_clearTimeout),
                                                         JS_CFUNC_MAGIC_DEF("setInterval", 2, tjs_setTimeout, 1),
-                                                        TJS_CFUNC_DEF("clearInterval", 1, tjs_clearTimeout) };
+                                                        TJS_CFUNC_DEF("clearInterval", 1, tjs_clearTimeout),
+                                                        JS_CFUNC_MAGIC_DEF("unrefTimer", 1, tjs_timer_setref, 0),
+                                                        JS_CFUNC_MAGIC_DEF("refTimer", 1, tjs_timer_setref, 1) };
 
 void tjs__mod_timers_init(JSContext *ctx, JSValue ns) {
     JS_SetPropertyFunctionList(ctx, ns, tjs_timer_funcs, countof(tjs_timer_funcs));
