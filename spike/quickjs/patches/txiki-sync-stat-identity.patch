     int fd;
     if (JS_ToInt32(ctx, &fd, argv[0])) return JS_EXCEPTION;
-    struct stat st;
-    if (fstat(fd, &st) < 0) return throw_errno(ctx, "fstat", NULL);
-    return stat_to_js(ctx, &st);
