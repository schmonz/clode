+/* CLODE (connect-next-address): the addresses a client connection tries, in the resolver's order, one after another
+ * while each connect() fails, as native Bun's and node's clients do. lws, handed one address, gives up on it; a name
+ * resolving to ::1 and 127.0.0.1 (localhost) failed outright against a server on 127.0.0.1 only.
+ * tjs__lws_addrs_fill: every IPv6/IPv4 answer of `res`, duplicates dropped, at most TJS_LWS_MAX_ADDRS.
+ * tjs__lws_connect_failed: lws's CLIENT_CONNECTION_ERROR reason names a connect() that failed or timed out (connect3.c's
+ * reasons), so nothing was sent and the next address may be tried; any later failure (TLS, the server's answer) not. */
+#define TJS_LWS_MAX_ADDRS 16
+typedef struct {
+    int count;
+    int next;
+    char addr[TJS_LWS_MAX_ADDRS][64];
+} TJSLwsAddrs;
+void tjs__lws_addrs_fill(TJSLwsAddrs *a, const struct addrinfo *res);
+bool tjs__lws_connect_failed(const char *why);
