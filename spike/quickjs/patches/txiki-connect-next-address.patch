+
+/* CLODE (connect-next-address): see private.h. */
+void tjs__lws_addrs_fill(TJSLwsAddrs *a, const struct addrinfo *res) {
+    a->count = 0;
+    a->next = 0;
+    for (const struct addrinfo *ai = res; ai && a->count < TJS_LWS_MAX_ADDRS; ai = ai->ai_next) {
+        char ip[64];
+        if (ai->ai_family == AF_INET6) {
+            uv_inet_ntop(AF_INET6, &((const struct sockaddr_in6 *) ai->ai_addr)->sin6_addr, ip, sizeof(ip));
+        } else if (ai->ai_family == AF_INET) {
+            uv_inet_ntop(AF_INET, &((const struct sockaddr_in *) ai->ai_addr)->sin_addr, ip, sizeof(ip));
+        } else {
+            continue;
+        }
+        bool seen = false;
+        for (int i = 0; i < a->count && !seen; i++) {
+            seen = !strcmp(a->addr[i], ip);
+        }
+        if (!seen) {
+            lws_strncpy(a->addr[a->count++], ip, sizeof(a->addr[0]));
+        }
+    }
 }
 
+bool tjs__lws_connect_failed(const char *why) {
+    return why && (!strcmp(why, "Unable to connect") || !strncmp(why, "conn fail:", 10) ||
+                   !strcmp(why, "incompatible v6 scopes"));
+}
