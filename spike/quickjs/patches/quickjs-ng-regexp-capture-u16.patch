# REGEXP-CAPTURE-U16: a RegExp may have up to 32,768 capture groups, as in native, not 254.
#
# WHY. QuickJS-ng refused any pattern with more than 254 capture groups ("too many
# captures"): CAPTURE_COUNT_MAX was 255 (it counts the whole match), because a capture
# index was ONE BYTE in libregexp's bytecode (save_start, save_end, back_reference,
# backward_back_reference, save_reset's two operands) and the header held the count in
# one byte. JavaScriptCore (Bun, i.e. native Claude Code) and V8 accept tens of
# thousands, so upstream never sees the limit. Claude Code builds patterns with one
# group per letter of a word list: the artifact-lead scrub pattern
# (bracketedLeadScrubPattern) had 559 groups at 2.1.278-2.1.283 and 588 at 2.1.327
# (a 980,559-character /giu pattern), and the harness-tag scrub patterns sat at 251 and
# 229 at 2.1.283. Under quaude `new RegExp` threw every time, and no subagent could
# finish. Until this patch an extractor hook (LEAD-SCRUB-POSSESSIVE) rewrote that ONE
# builder's separators to a group-free form; its anchor broke at 2.1.327 when upstream
# changed the builder, and it never covered the siblings. Fixing the engine covers every
# pattern the bundle builds, today's and the next, with upstream's own pattern text.
#
# THE FORMAT CHANGE. Capture indexes are u16 operands (those four opcodes grow from 2 to
# 3 bytes, save_reset from 3 to 5), and the header is 10 bytes, not 8:
#     flags u16 @0 | capture count u16 @2 | bytecode length u32 @4 | stack size u8 @8 | pad @9
# The flags and the bytecode length stay where they were ON PURPOSE:
# quickjs-ng-canonical-le-bytecode.patch's big-endian recompile reads exactly those two
# fields (flags at 0, length at 4) to tell little-endian bytecode from native and to
# recompile it, so that patch needs no change and still discriminates correctly.
# Every opcode walker (compute_stack_size, the simple-quantifier and check-advance scans)
# steps by reopcode_info[].size, which libregexp-opcode.h now states.
#
# THE LIMIT IS NATIVE'S. Measured 2026-11-21 by bisection inside native Claude Code 2.1.330
# (its own Bun/JavaScriptCore, through a BUN_OPTIONS=--preload probe): `new RegExp` accepts
# 32,768 groups and refuses 32,769 ("too many captures"). node 24.21.0 (V8) accepts 32,767.
# So CAPTURE_COUNT_MAX is 32,769 (the whole match plus 32,768 groups), which a u16 holds.
#
# BC_VERSION IS NOT BUMPED, deliberately: compiled regexp bytecode is embedded opaquely in
# JS bytecode, and clode's bytecode writer IS the runtime (clode-build.cjs, BC_VERSION and
# engine fingerprint lockstep, recorded by attest), so no other build's bytecode reaches
# this reader. Order-independent of every other quickjs-ng-*.patch: none touches
# libregexp.c, libregexp-opcode.h or lre-test.c. lre-test.c's hand-built bytecode moves
# to the new header and operand widths.
#
# Tests: test/engine-regexp-captures.test.cjs (under the engine, 32,768 groups compile and
# match and 32,769 are refused, native's boundary; 588 groups, with backreferences past 255,
# match as node matches them), and
# test/fidelity/regexp-capture-census.test.cjs (every pattern a real turn builds, against
# this limit).
diff --git a/libregexp-opcode.h b/libregexp-opcode.h
--- a/libregexp-opcode.h
+++ b/libregexp-opcode.h
@@ -36,16 +36,16 @@
 DEF(split_goto_first, 5)
 DEF(split_next_first, 5)
 DEF(match, 1)
-DEF(save_start, 2) /* save start position */
-DEF(save_end, 2) /* save end position, must come after saved_start */
-DEF(save_reset, 3) /* reset save positions */
+DEF(save_start, 3) /* save start position (u16 capture index) */
+DEF(save_end, 3) /* save end position, must come after saved_start */
+DEF(save_reset, 5) /* reset save positions (two u16 capture indexes) */
 DEF(loop, 5) /* decrement the top the stack and goto if != 0 */
 DEF(push_i32, 5) /* push integer on the stack */
 DEF(drop, 1)
 DEF(word_boundary, 1)
 DEF(not_word_boundary, 1)
-DEF(back_reference, 2)
-DEF(backward_back_reference, 2) /* must come after back_reference */
+DEF(back_reference, 3)
+DEF(backward_back_reference, 3) /* must come after back_reference */
 DEF(range, 3) /* variable length */
 DEF(range32, 3) /* variable length */
 DEF(lookahead, 5)
