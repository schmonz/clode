diff --git a/src/js/polyfills/event-target-polyfill.js b/src/js/polyfills/event-target-polyfill.js
index acade7e..dbbb259 100644
--- a/src/js/polyfills/event-target-polyfill.js
+++ b/src/js/polyfills/event-target-polyfill.js
@@ -60,16 +60,55 @@ class ErrorEvent extends Event {
 
 class MessageEvent extends Event {
     #data;
-
-    constructor(eventTye, data) {
-        super(eventTye);
-
-        this.#data = data;
+    #origin;
+    #lastEventId;
+    #source;
+    #ports;
+
+    /*
+     * CLODE: takes an INIT DICTIONARY, per spec and per node — NOT the payload.
+     *
+     * This used to be `constructor(eventTye, data) { this.#data = data; }`, so the
+     * whole dictionary landed in .data. That broke MCP over SSE outright: the
+     * bundle builds `new MessageEvent(type, { data, origin, lastEventId })` from
+     * the wire, then resolves `new URL(event.data, base)` — and with .data holding
+     * the dictionary, every JSON-RPC POST went to /[object Object]. The server saw
+     * requests arrive at a stringified object and the client hung forever.
+     *
+     * Nothing detected it because the shape was wrong, not missing: .data existed,
+     * it was simply the wrong object, and URL resolution dutifully stringified it.
+     */
+    constructor(type, eventInitDict = {}) {
+        super(type, eventInitDict);
+
+        const init = (eventInitDict && typeof eventInitDict === 'object') ? eventInitDict : {};
+
+        this.#data = init.data !== undefined ? init.data : null;
+        this.#origin = init.origin !== undefined ? String(init.origin) : '';
+        this.#lastEventId = init.lastEventId !== undefined ? String(init.lastEventId) : '';
+        this.#source = init.source !== undefined ? init.source : null;
+        this.#ports = init.ports !== undefined ? [ ...init.ports ] : [];
     }
 
     get data() {
         return this.#data;
     }
+
+    get origin() {
+        return this.#origin;
+    }
+
+    get lastEventId() {
+        return this.#lastEventId;
+    }
+
+    get source() {
+        return this.#source;
+    }
+
+    get ports() {
+        return this.#ports;
+    }
 }
 
 class PromiseRejectionEvent extends Event {
