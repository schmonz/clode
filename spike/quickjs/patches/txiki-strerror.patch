# STRERROR: __tjs_fs_sync.strerror(n), the platform's own text for an errno (its C library's strerror(3)).
#
# WHY. Every error text the engine hands JS is libuv's (uv_strerror, through tjs.Error and node-shim), and
# libuv's is its OWN table, not the OS's: `too many symbolic links encountered` where macOS, Linux and NetBSD
# say `Too many levels of symbolic links` (ELOOP), `name too long` for `File name too long`, `Unknown system
# error -102` for an errno it has no name for (macOS's EOPNOTSUPP on a socket). rg, built on the host, prints
# the C library's text (Rust's io::Error formats strerror_r), so quaude's rg printed different stderr from
# native's for those errnos (grep-native Task 10 fix round 2, review N1: 130 of 412 -L rows; BACKLOG "ERROR
# TEXT IS LIBUV'S, NOT rg's strerror"). One binding, and every platform answers with its own libc's text,
# which is exactly what rg built there prints. Never a table in JS.
#
# Guarded by test/rg-walk.test.cjs's RG-ERROR-TEXT rows (native literals) and by the engine-api-floor entry
# that refuses an engine without it.
diff --git a/src/mod_fs_sync.c b/src/mod_fs_sync.c
--- a/src/mod_fs_sync.c
+++ b/src/mod_fs_sync.c
@@ -440,6 +440,18 @@
 FSS_2PATH(symlink, symlink(a, b))
 #endif
 
+/* STRERROR: the platform's own text for an errno, as its C library's strerror(3) gives it. libuv's
+ * uv_strerror (what tjs.Error and node's messages carry) is libuv's OWN table, so it says "too many
+ * symbolic links encountered" where macOS, Linux and NetBSD say "Too many levels of symbolic links",
+ * and "Unknown system error -102" for an errno it has no name for. A program built on the host (rg:
+ * Rust's io::Error formats strerror_r) prints the libc text, so quaude's rg asks for it here. */
+#include <string.h>
+static JSValue js_fss_strerror(JSContext *ctx, JSValueConst t, int argc, JSValueConst *argv) {
+    int32_t n;
+    if (JS_ToInt32(ctx, &n, argv[0])) return JS_EXCEPTION;
+    return JS_NewString(ctx, strerror(n));
+}
+
 static const JSCFunctionListEntry fss_funcs[] = {
     JS_CFUNC_DEF("open", 2, js_fss_open),
     JS_CFUNC_DEF("read", 3, js_fss_read),
@@ -458,6 +470,7 @@
     JS_CFUNC_DEF("access", 2, js_fss_access),
     JS_CFUNC_DEF("symlink", 2, js_fss_symlink),
     JS_CFUNC_DEF("chmod", 2, js_fss_chmod),
+    JS_CFUNC_DEF("strerror", 1, js_fss_strerror),
 };
 
 void tjs__mod_fs_sync_init(JSContext *ctx, JSValue ns) {
