+    int kill_sig = SIGKILL;
+    JSValue ksv = JS_GetPropertyStr(ctx, opts, "killSignal");
+    if (JS_IsNumber(ksv)) { int32_t k = 0; if (JS_ToInt32(ctx, &k, ksv) == 0 && k > 0) kill_sig = k; }
