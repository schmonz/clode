+        if (windows_verbatim && p != cargv) buf_append(&cl, (const uint8_t *)*p, strlen(*p), (size_t)-1);
+        else append_quoted(&cl, *p);
+    }
     buf_append(&cl, (const uint8_t *)"\0", 1, (size_t)-1);  /* CreateProcessA needs a writable NUL-terminated string */
     char *envblk = build_env_block(cenv);
 
@@ -789,6 +811,7 @@
 
     STARTUPINFOA si; ZeroMemory(&si, sizeof(si)); si.cb = sizeof(si);
     si.dwFlags = STARTF_USESTDHANDLES;
+    if (windows_hide) { si.dwFlags |= STARTF_USESHOWWINDOW; si.wShowWindow = SW_HIDE; }
     si.hStdInput = child_h[0];
     si.hStdOutput = child_h[1];
     si.hStdError = child_h[2];
@@ -929,6 +952,17 @@
      * inherited or ignored, not only piped). node-shim's spawnSync reads it to
      * tell this engine from one that predates it, which pipes every slot. */
     JS_DefinePropertyValueStr(ctx, fn, "stdio", JS_TRUE, JS_PROP_ENUMERABLE);
