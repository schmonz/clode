diff --git a/src/mod_process.c b/src/mod_process.c
--- a/src/mod_process.c
+++ b/src/mod_process.c
@@ -158,6 +158,7 @@
 
     uv_process_options_t options;
     memset(&options, 0, sizeof(uv_process_options_t));
+    char *file_owned = NULL; /* the executable, when argv0 took args[0]'s place */
 
     options.flags = UV_PROCESS_WINDOWS_FILE_PATH_EXACT_NAME;
 
@@ -320,6 +321,48 @@
         }
         JS_FreeValue(ctx, js_gid);
 
+        /* node's spawn flags, as libuv's: detached (a new session, so the child
+         * leads its own process group and kill(-pid) reaches its tree),
+         * windowsHide, windowsVerbatimArguments. Read on every platform; libuv
+         * ignores the two Windows flags elsewhere, as node does. */
+        static const struct { const char *name; unsigned int flag; } spawn_flags[] = {
+            { "detached", UV_PROCESS_DETACHED },
+            { "windowsHide", UV_PROCESS_WINDOWS_HIDE },
+            { "windowsVerbatimArguments", UV_PROCESS_WINDOWS_VERBATIM_ARGUMENTS },
+        };
+        for (size_t k = 0; k < countof(spawn_flags); k++) {
+            JSValue js_flag = JS_GetPropertyStr(ctx, arg1, spawn_flags[k].name);
+            if (JS_IsException(js_flag)) {
+                goto fail;
+            }
+            if (JS_ToBool(ctx, js_flag) > 0) {
+                options.flags |= spawn_flags[k].flag;
+            }
+            JS_FreeValue(ctx, js_flag);
+        }
+
+        /* argv0: the child's argv[0], while the executable stays args[0] as given
+         * (libuv runs options.file and passes options.args) */
+        JSValue js_argv0 = JS_GetPropertyStr(ctx, arg1, "argv0");
+        if (JS_IsException(js_argv0)) {
+            goto fail;
+        }
+        if (JS_IsString(js_argv0)) {
+            const char *a0 = JS_ToCString(ctx, js_argv0);
+            char *a0_dup = a0 ? js_strdup(ctx, a0) : NULL;
+            if (a0) {
+                JS_FreeCString(ctx, a0);
+            }
+            if (!a0_dup) {
+                JS_FreeValue(ctx, js_argv0);
+                goto fail;
+            }
+            file_owned = options.args[0];
+            options.args[0] = a0_dup;
+            options.file = file_owned;
+        }
+        JS_FreeValue(ctx, js_argv0);
+
         /* stdio */
         JSValue js_stdin = JS_GetPropertyStr(ctx, arg1, "stdin");
         if (!JS_IsException(js_stdin) && !JS_IsUndefined(js_stdin)) {
@@ -466,6 +509,9 @@
     if (options.cwd) {
         js_free(ctx, (void *) options.cwd);
     }
+    if (file_owned) {
+        js_free(ctx, file_owned);
+    }
 
     return ret;
 }
@@ -591,4 +637,16 @@
     JS_SetClassProto(ctx, tjs_process_class_id, proto);
 
     JS_SetPropertyFunctionList(ctx, ns, tjs_process_funcs, countof(tjs_process_funcs));
+
+    /* globalThis.__tjs_spawn_options: the node spawn options tjs.spawn honours
+     * beyond cwd/env/uid/gid/stdio, so node-shim can tell this engine from one
+     * that predates them (and refuse, by name, what an older engine would drop). */
+    static const char *const spawn_option_names[] = { "detached", "windowsHide", "windowsVerbatimArguments", "argv0" };
+    JSValue names = JS_NewArray(ctx);
+    for (uint32_t k = 0; k < countof(spawn_option_names); k++) {
+        JS_SetPropertyUint32(ctx, names, k, JS_NewString(ctx, spawn_option_names[k]));
+    }
+    JSValue global = JS_GetGlobalObject(ctx);
+    JS_DefinePropertyValueStr(ctx, global, "__tjs_spawn_options", names, JS_PROP_C_W_E);
+    JS_FreeValue(ctx, global);
 }
diff --git a/src/mod_spawn_sync.c b/src/mod_spawn_sync.c
