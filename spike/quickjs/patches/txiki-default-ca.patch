+/* CLODE (default-ca): __tjs_set_default_ca(pem) REPLACES the CA set every engine client trusts by default, for the
+ * connections made from now on: fetch, XMLHttpRequest and WebSocket (lws), and tjs.connect('tls') without a `ca` of its
+ * own (mod_tls). node's tls.setDefaultCACertificates(certs) does exactly that, and native Claude Code calls it with
+ * the CA list it builds (its bundled roots minus the ones it blocks, plus NODE_EXTRA_CA_CERTS and the OS store) and
+ * passes the same list to every fetch as `tls.ca`. The engine took neither: its fetch trusted its own compiled-in roots
+ * whatever the caller asked, including four roots (emSign) native Claude Code refuses to trust (measured 2026-11-23,
+ * 2.1.330). The node-shim's tls module answers setDefaultCACertificates with this, and refuses a fetch whose `tls.ca`
+ * is not the set in force (libexec/bun-shim.cjs).
+ * The whole set is parsed first; one certificate that fails, or none at all, throws a TypeError naming why and
+ * changes nothing (lws would refuse the whole set, ending every HTTPS request). Callable again: each call replaces. */
+static JSValue tjs__set_default_ca_global(JSContext *ctx, JSValue this_val, int argc, JSValue *argv) {
+    TJSRuntime *qrt = TJS_GetRuntime(ctx);
+    CHECK_NOT_NULL(qrt);
+
+    size_t len;
+    const char *pem = JS_ToCStringLen(ctx, &len, argv[0]);
+    if (!pem) {
+        return JS_EXCEPTION;
+    }
+
+    char why[200];
+    if (tjs__tls_set_default_ca(qrt, pem, len, why, sizeof(why)) != 0) {
+        JS_FreeCString(ctx, pem);
+        return JS_ThrowTypeError(ctx, "default CA set refused: %s", why);
+    }
+
+    uint8_t *copy = js_malloc(ctx, len + 1);
+    if (!copy) {
+        JS_FreeCString(ctx, pem);
+        return JS_EXCEPTION;
+    }
+    memcpy(copy, pem, len + 1);
+    JS_FreeCString(ctx, pem);
+    tjs__lws_set_default_ca(qrt, copy, (unsigned int) len);
+
+    return JS_UNDEFINED;
+}
