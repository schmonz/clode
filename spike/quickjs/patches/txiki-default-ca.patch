+/* CLODE (default-ca): replace the CA set fetch, XMLHttpRequest and WebSocket trust, for connections made from now on.
+ * Takes ownership of `pem` (js_malloc'd). The vhosts in use keep the set they were made with, and are kept: a request
+ * in flight on one is not cut off. New ones are made at the next connection (tjs__lws_select_vhost), so a run of
+ * calls costs one set of vhosts, not one per call. */
+void tjs__lws_set_default_ca(TJSRuntime *qrt, uint8_t *pem, unsigned int len) {
+    js_free(qrt->ctx, qrt->lws.ca_bundle_data);
+    qrt->lws.ca_bundle_data = pem;
+    qrt->lws.ca_bundle_len = len;
+    qrt->lws.ca_gen++;
