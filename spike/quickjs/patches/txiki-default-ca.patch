+/* CLODE (default-ca): a CA set that REPLACES the default trust of every tjs.connect('tls') made from now on without a
+ * `ca` of its own (node's tls.setDefaultCACertificates). Each set is its own chain, kept until the runtime ends: a
+ * connection configured with an earlier one still points at it. */
+struct TJSDefaultCa {
+    mbedtls_x509_crt crt;
+    struct TJSDefaultCa *next;
+};
+
+int tjs__tls_set_default_ca(TJSRuntime *qrt, const char *pem, size_t len, char *why, size_t why_len) {
+    struct TJSDefaultCa *d = tjs__mallocz(sizeof(*d));
+    if (!d) {
+        snprintf(why, why_len, "out of memory");
+        return -1;
+    }
+    mbedtls_x509_crt_init(&d->crt);
+    /* len + 1: mbedtls reads PEM only when the NUL is counted (the caller's string is NUL-terminated). */
+    int r = mbedtls_x509_crt_parse(&d->crt, (const unsigned char *) pem, len + 1);
+    if (r != 0 || d->crt.raw.len == 0) {
+        if (r < 0) {
+            char err[120];
+            mbedtls_strerror(r, err, sizeof(err));
+            snprintf(why, why_len, "mbedtls -0x%04x: %s", (unsigned int) -r, err);
+        } else if (r > 0) {
+            snprintf(why, why_len, "%d certificate(s) failed to parse", r);
+        } else {
+            snprintf(why, why_len, "no certificate in it");
+        }
+        mbedtls_x509_crt_free(&d->crt);
+        tjs__free(d);
+        return -1;
+    }
+    d->next = qrt->tls.default_ca;
+    qrt->tls.default_ca = d;
+    return 0;
+}
 
