diff --git a/lib/core-net/client/client.c b/lib/core-net/client/client.c
--- a/lib/core-net/client/client.c
+++ b/lib/core-net/client/client.c
@@ -26,7 +26,27 @@
 
 #if defined(LWS_CLIENT_HTTP_PROXYING)
 
+/* CLODE (lws-proxy-connect): see libwebsockets/lws-context-vhost.h */
 int
+lws_set_proxy_connect_headers(struct lws_vhost *vhost, const char *headers)
+{
+	char *copy = NULL;
+
+	if (headers) {
+		size_t n = strlen(headers);
+
+		copy = lws_malloc(n + 1, "proxy connect headers");
+		if (!copy)
+			return -1;
+		memcpy(copy, headers, n + 1);
+	}
+	lws_free(vhost->proxy_connect_headers);
+	vhost->proxy_connect_headers = copy;
+
+	return 0;
+}
+
+int
 lws_set_proxy(struct lws_vhost *vhost, const char *proxy)
 {
 	char authstring[96];
@@ -97,6 +117,9 @@
 			return -1;
 		}
 		*ncp++ = '\0';
+		/* CLODE (lws-proxy-connect): the port follows the bracket; searching from the start found the
+		 * first ':' of the address itself ("[::1]:8080" took port atoi(":1") = 0) */
+		p = ncp;
 	}
 #endif
 
