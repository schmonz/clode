diff --git a/include/libwebsockets/lws-context-vhost.h b/include/libwebsockets/lws-context-vhost.h
--- a/include/libwebsockets/lws-context-vhost.h
+++ b/include/libwebsockets/lws-context-vhost.h
@@ -1210,6 +1210,19 @@
 lws_set_proxy(struct lws_vhost *vhost, const char *proxy);
 
 /**
+ * lws_set_proxy_connect_headers() - the header lines a CONNECT to this vhost's proxy carries
+ * \param vhost:	the vhost whose http proxy is used (lws_set_proxy / http_proxy_address)
+ * \param headers:	CRLF-terminated header lines, sent verbatim after the Host line; NULL restores the default
+ *
+ * CLODE (lws-proxy-connect): by default a CONNECT carries "User-agent: lws" and, when the proxy address had
+ * userinfo, "Proxy-authorization: basic <token>". A client that must say what another client says (a
+ * Proxy-Authorization of any scheme, a Proxy-Connection line, the caller's own proxy headers) sets the whole
+ * block here; the default lines are then not sent. The string is copied. Returns 0, or -1 if it cannot be kept.
+ */
+LWS_VISIBLE LWS_EXTERN int
+lws_set_proxy_connect_headers(struct lws_vhost *vhost, const char *headers);
+
+/**
  * lws_set_socks() - Setup socks to lws_context.
  * \param vhost:	pointer to struct lws_vhost you want set socks for
  * \param socks: pointer to c string containing socks in format address:port
