+        lws_strncpy(cfg.auth_address, host, sizeof(cfg.auth_address));
+    }
+    lws_strncpy(cfg.hostname, host, sizeof(cfg.hostname));
+    cfg.port = (unsigned int) port;
+
+    static unsigned int serial;
+    char name[48];
+    snprintf(name, sizeof(name), "tjs-own-proxy-%u-%u", qrt->lws.ca_gen, ++serial);
+    struct lws_vhost *vh = tjs__create_client_vhost(qrt, name, &cfg);
+    if (!vh) {
+        return NULL;
+    }
+    if (lws_set_proxy_connect_headers(vh, hdrs)) {
+        return NULL;
+    }
