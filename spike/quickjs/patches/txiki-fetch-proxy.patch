+/* CLODE (fetch-proxy): the bookkeeping only; lws_context_destroy has already destroyed the vhosts. */
+void tjs__lws_free_proxy_vhosts(TJSRuntime *qrt) {
+    TJSProxyVhost *p = qrt->lws.proxy_vhosts;
+    while (p) {
+        TJSProxyVhost *next = p->next;
+        tjs__free(p->host);
+        tjs__free(p->headers);
+        tjs__free(p);
+        p = next;
+    }
+    qrt->lws.proxy_vhosts = NULL;
+}
