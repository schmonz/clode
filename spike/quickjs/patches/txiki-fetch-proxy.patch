+struct lws_vhost *tjs__lws_proxy_vhost(JSContext *ctx, const char *host, int port, const char *connect_headers) {
+    TJSRuntime *qrt = TJS_GetRuntime(ctx);
+    CHECK_NOT_NULL(qrt);
+    const char *hdrs = connect_headers ? connect_headers : "";
+
+    for (TJSProxyVhost *p = qrt->lws.proxy_vhosts; p; p = p->next) {
+        if (p->gen == qrt->lws.ca_gen && p->port == port && !strcmp(p->host, host) && !strcmp(p->headers, hdrs)) {
+            return p->vh;
+        }
+    }
