+    TJSProxyConfig cfg;
+    memset(&cfg, 0, sizeof(cfg));
+    /* lws_set_proxy() reads an IPv6 literal only in brackets */
+    if (strchr(host, ':')) {
+        lws_snprintf(cfg.auth_address, sizeof(cfg.auth_address), "[%s]", host);
