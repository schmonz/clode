+    TJSProxyVhost *p = tjs__mallocz(sizeof(*p));
+    CHECK_NOT_NULL(p);
+    p->host = tjs__strdup(host);
+    p->headers = tjs__strdup(hdrs);
+    CHECK_NOT_NULL(p->host);
+    CHECK_NOT_NULL(p->headers);
+    p->port = port;
+    p->gen = qrt->lws.ca_gen;
+    p->vh = vh;
+    p->next = qrt->lws.proxy_vhosts;
+    qrt->lws.proxy_vhosts = p;
+
+    return vh;
